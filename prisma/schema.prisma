generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "postgresql"
}

// Enum RBAC

enum Cargo {
  LOCATARIO
  LOCADOR
  ADMIN
}

// Enums para os status dos veículos, reservas e pagamentos

enum StatusVeiculo {
  DISPONIVEL
  RESERVADO
  MANUTENCAO
  INATIVO
}

enum StatusReserva {
  AGUARDANDO_PAGAMENTO
  CONFIRMADA
  EM_ANDAMENTO
  REALIZADA
  CANCELADA
}

enum StatusPagamento {
  AGUARDANDO_PAGAMENTO
  PROCESSANDO
  SUCESSO
  FALHA
}

// Models para as entidades do sistema

model Conta {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  email     String   @unique
  telefone  String?
  senhaHash String
  criadaEm  DateTime @default(now())
  cargo     Cargo    @default(LOCATARIO)

  cep      String
  endereco String

  locatario    Locatario?
  locador      Locador?
  atualizadoEm DateTime   @default(now()) @updatedAt
}

model Deficiencia {
  id        String @id @default(uuid()) @db.Uuid
  descricao String

  locatarios   Locatario[]
  atualizadoEm DateTime    @default(now()) @updatedAt
}

model Locatario {
  id  String @id @db.Uuid
  cpf String @unique
  cnh String @unique

  conta Conta @relation(fields: [id], references: [id], onDelete: Cascade)

  deficienciaId String?      @db.Uuid
  deficiencia   Deficiencia? @relation(fields: [deficienciaId], references: [id])

  reservas     Reserva[]
  atualizadoEm DateTime  @default(now()) @updatedAt
}

model Locador {
  id      String @id @db.Uuid
  empresa String
  cnpj    String @unique

  conta Conta @relation(fields: [id], references: [id], onDelete: Cascade)

  veiculos       Veiculo[]
  garagens       Garagem[]
  modelosVeiculo ModeloVeiculo[]
  atualizadoEm   DateTime        @default(now()) @updatedAt
}

model ModeloVeiculo {
  id           String    @id @default(uuid()) @db.Uuid
  idLocador    String    @db.Uuid
  locador      Locador   @relation(fields: [idLocador], references: [id], onDelete: Cascade)
  marca        String
  modelo       String
  ano          Int
  cambio       String
  capacidade   Int
  eletrico     Boolean
  adaptado     Boolean
  criadoEm     DateTime  @default(now())
  veiculos     Veiculo[]
  atualizadoEm DateTime  @default(now()) @updatedAt

  @@unique([idLocador, marca, modelo, ano])
}

model Veiculo {
  id              String        @id @default(uuid()) @db.Uuid
  idLocador       String        @db.Uuid
  locador         Locador       @relation(fields: [idLocador], references: [id], onDelete: Cascade)
  idModeloVeiculo String        @db.Uuid
  modeloVeiculo   ModeloVeiculo @relation(fields: [idModeloVeiculo], references: [id])
  garagemId       String?       @db.Uuid
  garagem         Garagem?      @relation(fields: [garagemId], references: [id])
  placa           String        @unique
  status          StatusVeiculo @default(DISPONIVEL)
  criadoEm        DateTime      @default(now())
  reservas        Reserva[]
  localizacoes    Localizacao[]
  atualizadoEm    DateTime      @default(now()) @updatedAt
}

model Garagem {
  id String @id @default(uuid()) @db.Uuid

  idLocador String  @db.Uuid
  locador   Locador @relation(fields: [idLocador], references: [id], onDelete: Cascade)

  nome     String
  endereco String

  capacidade       Int
  veiculosAlocados Int

  acessibilidade Boolean @default(true)

  criadaEm DateTime @default(now())

  veiculos     Veiculo[]
  atualizadoEm DateTime  @default(now()) @updatedAt
}

model Reserva {
  id String @id @default(uuid()) @db.Uuid

  idVeiculo String  @db.Uuid
  veiculo   Veiculo @relation(fields: [idVeiculo], references: [id])

  idLocatario String    @db.Uuid
  locatario   Locatario @relation(fields: [idLocatario], references: [id])

  dataHoraInicio DateTime
  dataHoraFim    DateTime

  criadaEm DateTime @default(now())

  valorTotal Decimal @db.Decimal(10, 2)

  status          StatusReserva   @default(AGUARDANDO_PAGAMENTO)
  statusPagamento StatusPagamento @default(AGUARDANDO_PAGAMENTO)

  // Código de desbloqueio do veículo (formato XXXX-XXXX), gerado quando o
  // pagamento é confirmado (statusPagamento = SUCESSO). Janela de uso:
  // a partir de dataHoraInicio até min(dataHoraInicio + 2 dias, dataHoraFim).
  codigoDesbloqueio String?   @unique
  codigoGeradoEm    DateTime?
  codigoUsadoEm     DateTime?

  avaliacao    Avaliacao?
  atualizadoEm DateTime   @default(now()) @updatedAt
}

model Localizacao {
  id String @id @default(uuid()) @db.Uuid

  idVeiculo String  @db.Uuid
  veiculo   Veiculo @relation(fields: [idVeiculo], references: [id], onDelete: Cascade)

  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(10, 8)

  dataHora     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt
}

model Avaliacao {
  id String @id @default(uuid()) @db.Uuid

  idReserva String  @unique @db.Uuid
  reserva   Reserva @relation(fields: [idReserva], references: [id], onDelete: Cascade)

  comentario String?
  data       DateTime @default(now())

  nota         Decimal  @db.Decimal(2, 1)
  atualizadoEm DateTime @default(now()) @updatedAt
}
