generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "postgresql"
}

// Enum RBAC

enum Cargo {
  LOCATARIO
  LOCADOR
  ADMIN
}

// Enums para os status dos veículos, reservas e pagamentos

enum StatusVeiculo {
  DISPONIVEL
  RESERVADO
  MANUTENCAO
  INATIVO
}

enum CategoriaVeiculo {
  ECONOMICO
  ESPACOSO
  EXECUTIVO
  PCD
}

enum StatusReserva {
  AGUARDANDO_PAGAMENTO
  CONFIRMADA
  EM_ANDAMENTO
  REALIZADA
  CANCELADA
}

enum StatusPagamento {
  AGUARDANDO_PAGAMENTO
  PROCESSANDO
  SUCESSO
  FALHA
}

enum StatusVeiculoImagem {
  PENDING
  READY
  DELETING
}

enum MetodoPagamento {
  CARTAO_CREDITO
  CARTAO_DEBITO
  PIX
  CARTEIRA_DIGITAL
}

enum TipoCobranca {
  CANCELAMENTO
  ATRASO_DEVOLUCAO
  // Cobrança principal da reserva, registrada ao iniciar o pagamento.
  PAGAMENTO_RESERVA
}

enum StatusGaragem {
  ATIVA
  INATIVA
  MANUTENCAO
}

enum StatusNotificacao {
  PENDENTE
  ENVIADA
  FALHA
}

enum StatusInteresse {
  ATIVO
  CANCELADO
  NOTIFICADO
}

enum TipoAlertaVeiculo {
  INATIVIDADE
  BAIXA_AVALIACAO
}

enum MotivoBloqueio {
  INADIMPLENCIA
  FRAUDE
  DOCUMENTACAO
  MULTA
  ADMINISTRATIVO
  OUTRO
}

// Models para as entidades do sistema

model Conta {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  email     String   @unique
  telefone  String?
  senhaHash String
  criadaEm  DateTime @default(now())
  cargo     Cargo    @default(LOCATARIO)

  cep      String
  endereco String

  anonimizadoEm DateTime?

  locatario    Locatario?
  locador      Locador?
  // Auditoria LGPD: acessos onde esta conta é a titular / a autora do acesso.
  acessosComoTitular AcessoDadoPessoal[] @relation("AcessoTitular")
  acessosComoAutor   AcessoDadoPessoal[] @relation("AcessoAutor")
  // Preferências de notificação (canal x tipo, opt-in/opt-out).
  preferenciasNotificacao PreferenciaNotificacao[]
  recuperacoesSenha       RecuperacaoSenha[]
  atualizadoEm DateTime   @default(now()) @updatedAt
}

enum TipoEventoFinanceiroSandbox {
  PAGAMENTO_RECEBIDO
  ESTORNO_SOLICITADO
  ESTORNO_CONCLUIDO
  ESTORNO_FALHOU
}

model RecuperacaoSenha {
  id        String   @id @default(uuid()) @db.Uuid
  idConta   String   @db.Uuid
  conta     Conta    @relation(fields: [idConta], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime @default(now())

  @@index([idConta])
}

enum CanalNotificacao {
  EMAIL
  PUSH
  SMS
}

// Tipos de notificação que o usuário pode habilitar/desabilitar.
enum TipoNotificacao {
  RESERVA
  ALERTA_VEICULO
  VEICULO_DISPONIVEL
}

model PreferenciaNotificacao {
  id           String           @id @default(uuid()) @db.Uuid
  idConta      String           @db.Uuid
  conta        Conta            @relation(fields: [idConta], references: [id], onDelete: Cascade)
  canal        CanalNotificacao
  tipo         TipoNotificacao
  habilitado   Boolean          @default(true)
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @default(now()) @updatedAt

  @@unique([idConta, canal, tipo])
}

// Ações registradas na auditoria de acesso a dados pessoais (LGPD).
enum AcaoLgpd {
  EXPORTAR
  ANONIMIZAR
  CONSULTAR
}

// Trilha de auditoria LGPD: quem acessou os dados pessoais de quem, e quando.
model AcessoDadoPessoal {
  id        String   @id @default(uuid()) @db.Uuid
  // Titular dos dados acessados.
  idTitular String   @db.Uuid
  titular   Conta    @relation("AcessoTitular", fields: [idTitular], references: [id], onDelete: Cascade)
  // Autor do acesso (o próprio titular ou um ADMIN).
  idAutor   String   @db.Uuid
  autor     Conta    @relation("AcessoAutor", fields: [idAutor], references: [id], onDelete: Cascade)
  acao      AcaoLgpd
  detalhe   String?
  criadoEm  DateTime @default(now())

  @@index([idTitular])
}

model Deficiencia {
  id        String @id @default(uuid()) @db.Uuid
  descricao String

  locatarios   Locatario[]
  atualizadoEm DateTime    @default(now()) @updatedAt
}

model Locatario {
  id  String @id @db.Uuid
  cpf String @unique
  cnh String @unique
  rg  String

  dataNascimento DateTime @db.Date

  conta Conta @relation(fields: [id], references: [id], onDelete: Cascade)

  deficienciaId String?      @db.Uuid
  deficiencia   Deficiencia? @relation(fields: [deficienciaId], references: [id])

  reservas     Reserva[]
  bloqueios    BloqueioLocatario[]
  favoritos    Favorito[]
  interesses   InteresseVeiculo[]
  atualizadoEm DateTime  @default(now()) @updatedAt
}

model Locador {
  id      String @id @db.Uuid
  empresa String
  cnpj    String @unique

  conta Conta @relation(fields: [id], references: [id], onDelete: Cascade)

  veiculos       Veiculo[]
  garagens       Garagem[]
  modelosVeiculo ModeloVeiculo[]
  alertas        AlertaVeiculo[]
  atualizadoEm   DateTime        @default(now()) @updatedAt
}

model ModeloVeiculo {
  id           String    @id @default(uuid()) @db.Uuid
  idLocador    String    @db.Uuid
  locador      Locador   @relation(fields: [idLocador], references: [id], onDelete: Cascade)
  marca        String
  modelo       String
  ano          Int
  cambio       String
  capacidade   Int
  eletrico     Boolean
  adaptado     Boolean
  // Categoria comercial (RF07/RF16). Nula até o locador classificar o modelo.
  categoria    CategoriaVeiculo?
  valorDiaria  Decimal   @db.Decimal(10, 2)
  criadoEm     DateTime  @default(now())
  veiculos     Veiculo[]
  atualizadoEm DateTime  @default(now()) @updatedAt

  @@unique([idLocador, marca, modelo, ano])
}

model Veiculo {
  id              String        @id @default(uuid()) @db.Uuid
  idLocador       String        @db.Uuid
  locador         Locador       @relation(fields: [idLocador], references: [id], onDelete: Cascade)
  idModeloVeiculo String        @db.Uuid
  modeloVeiculo   ModeloVeiculo @relation(fields: [idModeloVeiculo], references: [id])
  garagemId       String?       @db.Uuid
  garagem         Garagem?      @relation(fields: [garagemId], references: [id])
  placa           String        @unique
  status          StatusVeiculo @default(DISPONIVEL)
  criadoEm        DateTime      @default(now())
  reservas        Reserva[]
  localizacoes    Localizacao[]
  favoritos       Favorito[]
  interesses      InteresseVeiculo[]
  statusHistorico VeiculoStatusHistorico[]
  alertas         AlertaVeiculo[]
  imagens         VeiculoImagem[]
  atualizadoEm    DateTime      @default(now()) @updatedAt
}

model VeiculoImagem {
  id         String             @id @default(uuid()) @db.Uuid
  idVeiculo  String             @db.Uuid
  veiculo    Veiculo            @relation(fields: [idVeiculo], references: [id], onDelete: Cascade)
  objectKey  String             @unique
  ordem      Int
  altText    String?
  mimeType   String
  tamanho    Int
  largura    Int
  altura     Int
  status     StatusVeiculoImagem @default(PENDING)
  criadaEm   DateTime           @default(now())
  atualizadoEm DateTime         @default(now()) @updatedAt

  @@unique([idVeiculo, ordem])
  @@index([idVeiculo, status, ordem])
}

model Garagem {
  id String @id @default(uuid()) @db.Uuid

  idLocador String  @db.Uuid
  locador   Locador @relation(fields: [idLocador], references: [id], onDelete: Cascade)

  nome     String
  endereco String

  capacidade       Int
  veiculosAlocados Int

  acessibilidade Boolean @default(true)

  status StatusGaragem @default(ATIVA)

  criadaEm DateTime @default(now())

  veiculos          Veiculo[]
  reservasRetirada  Reserva[] @relation("ReservasRetirada")
  reservasDevolucao Reserva[] @relation("ReservasDevolucao")
  atualizadoEm      DateTime  @default(now()) @updatedAt
}

model Reserva {
  id String @id @default(uuid()) @db.Uuid

  idVeiculo String  @db.Uuid
  veiculo   Veiculo @relation(fields: [idVeiculo], references: [id])

  idLocatario String    @db.Uuid
  locatario   Locatario @relation(fields: [idLocatario], references: [id])

  idGaragemRetirada String?  @db.Uuid
  garagemRetirada   Garagem? @relation("ReservasRetirada", fields: [idGaragemRetirada], references: [id])

  idGaragemDevolucao String?  @db.Uuid
  garagemDevolucao   Garagem? @relation("ReservasDevolucao", fields: [idGaragemDevolucao], references: [id])

  dataHoraInicio DateTime
  dataHoraFim    DateTime

  criadaEm DateTime @default(now())

  valorTotal Decimal @db.Decimal(10, 2)

  status          StatusReserva   @default(AGUARDANDO_PAGAMENTO)
  statusPagamento StatusPagamento @default(AGUARDANDO_PAGAMENTO)

  metodoPagamento MetodoPagamento?

  codigoDesbloqueio String?   @unique
  codigoGeradoEm    DateTime?
  codigoUsadoEm     DateTime?

  devolvidoEm DateTime?

  expiradaEm DateTime?

  avaliacao    Avaliacao?
  // Condutores adicionais autorizados a dirigir nesta reserva (RF12).
  condutores   CondutorAdicional[]
  // Serviços opcionais contratados nesta reserva (catálogo + junção).
  servicos     ReservaServico[]
  // Histórico de notificações (relatório por e-mail etc.) desta reserva.
  notificacoes NotificacaoReserva[]
  // Cobranças avulsas lançadas sobre a reserva (multa de cancelamento — RN04).
  cobrancas    CobrancaReserva[]
  eventosFinanceirosSandbox EventoFinanceiroSandbox[]
  // Link público opcional da viagem (RF13-B), um ativo por reserva.
  compartilhamento CompartilhamentoReserva?
  atualizadoEm DateTime   @default(now()) @updatedAt
}

model EventoFinanceiroSandbox {
  id String @id @default(uuid()) @db.Uuid

  idReserva String @db.Uuid
  reserva   Reserva @relation(fields: [idReserva], references: [id])

  tipo TipoEventoFinanceiroSandbox
  // Chave determinística por evento/etapa; torna reentregas inofensivas.
  chaveIdempotencia String @unique
  provider String
  criadoEm DateTime @default(now())

  @@index([idReserva, criadoEm])
}

model CompartilhamentoReserva {
  id           String   @id @default(uuid()) @db.Uuid
  idReserva    String   @unique @db.Uuid
  reserva      Reserva  @relation(fields: [idReserva], references: [id], onDelete: Cascade)
  token        String   @unique
  criadoEm     DateTime @default(now())
  revogadoEm   DateTime?
  atualizadoEm DateTime @default(now()) @updatedAt
}

model CobrancaReserva {
  id String @id @default(uuid()) @db.Uuid

  idReserva String  @db.Uuid
  reserva   Reserva @relation(fields: [idReserva], references: [id], onDelete: Cascade)

  tipo  TipoCobranca
  valor Decimal      @db.Decimal(10, 2)
  // Reusa a máquina de estados do gateway; não há uma segunda noção de quitação.
  statusPagamento StatusPagamento @default(AGUARDANDO_PAGAMENTO)
  metodoPagamento MetodoPagamento?

  criadoEm DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([idReserva])
  @@index([statusPagamento])
}

model NotificacaoReserva {
  id String @id @default(uuid()) @db.Uuid

  idReserva String  @db.Uuid
  reserva   Reserva @relation(fields: [idReserva], references: [id], onDelete: Cascade)

  // Snapshot do destinatário e do assunto no momento da tentativa.
  destinatario String
  assunto      String
  canal        String @default("EMAIL")

  status       StatusNotificacao @default(PENDENTE)
  // Motivo da falha (mensagem do provedor), quando status = FALHA.
  mensagemErro String?

  criadaEm     DateTime  @default(now())
  // Instante em que o provedor aceitou a mensagem (status = ENVIADA).
  enviadaEm    DateTime?
  atualizadoEm DateTime  @default(now()) @updatedAt

  @@index([idReserva])
}

model ServicoOpcional {
  id        String  @id @default(uuid()) @db.Uuid
  nome      String  @unique
  descricao String
  // Detalhes funcionais da cobertura/entrega simulada, quando aplicável.
  detalhesCobertura String?
  valor     Decimal @db.Decimal(10, 2)

  ativo Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  reservas ReservaServico[]

  // Acelera a listagem dos serviços disponíveis (ativo = true).
  @@index([ativo])
}

model ReservaServico {
  idReserva String  @db.Uuid
  reserva   Reserva @relation(fields: [idReserva], references: [id], onDelete: Cascade)

  idServico String          @db.Uuid
  servico   ServicoOpcional @relation(fields: [idServico], references: [id])

  // Snapshot do valor do serviço no momento da contratação.
  valor Decimal @db.Decimal(10, 2)
  // Snapshots descritivos: histórico não muda quando o catálogo é editado.
  nome              String?
  descricao         String?
  detalhesCobertura String?

  criadoEm DateTime @default(now())

  @@id([idReserva, idServico])
  @@index([idServico])
}

model Favorito {
  id String @id @default(uuid()) @db.Uuid

  idLocatario String    @db.Uuid
  locatario   Locatario @relation(fields: [idLocatario], references: [id], onDelete: Cascade)

  idVeiculo String  @db.Uuid
  veiculo   Veiculo @relation(fields: [idVeiculo], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@unique([idLocatario, idVeiculo])
  // Acelera estatísticas de veículos mais favoritados e o cascade por veículo.
  @@index([idVeiculo])
}

model InteresseVeiculo {
  id String @id @default(uuid()) @db.Uuid

  idLocatario String    @db.Uuid
  locatario   Locatario @relation(fields: [idLocatario], references: [id], onDelete: Cascade)

  idVeiculo String  @db.Uuid
  veiculo   Veiculo @relation(fields: [idVeiculo], references: [id], onDelete: Cascade)

  status StatusInteresse @default(ATIVO)

  optInEm DateTime @default(now())

  // Encerramentos: cancelamento manual (opt-out) ou notificação bem-sucedida.
  canceladoEm  DateTime?
  notificadoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  // Histórico/auditoria dos envios desta inscrição.
  notificacoes NotificacaoInteresse[]

  @@unique([idLocatario, idVeiculo])
  // Consulta crítica do disparo automático: inscrições ATIVAS de um veículo.
  @@index([idVeiculo, status])
}

model NotificacaoInteresse {
  id String @id @default(uuid()) @db.Uuid

  idInteresse String           @db.Uuid
  interesse   InteresseVeiculo @relation(fields: [idInteresse], references: [id], onDelete: Cascade)

  // Snapshot do destinatário e do assunto no momento da tentativa.
  destinatario String
  assunto      String
  // Canal de envio. String (não enum) para permitir novos canais sem migração.
  canal        String @default("EMAIL")

  status       StatusNotificacao @default(PENDENTE)
  // Motivo da falha (mensagem do provedor), quando status = FALHA.
  mensagemErro String?

  criadaEm     DateTime  @default(now())
  // Instante em que o provedor aceitou a mensagem (status = ENVIADA).
  enviadaEm    DateTime?
  atualizadoEm DateTime  @default(now()) @updatedAt

  @@index([idInteresse])
}

model VeiculoStatusHistorico {
  id String @id @default(uuid()) @db.Uuid

  idVeiculo String  @db.Uuid
  veiculo   Veiculo @relation(fields: [idVeiculo], references: [id], onDelete: Cascade)

  status StatusVeiculo

  criadoEm DateTime @default(now())

  // Acelera a busca da transição mais recente por veículo (LATERAL/max).
  @@index([idVeiculo, criadoEm])
}

enum EntidadeAuditada {
  VEICULO
  RESERVA
}

enum AcaoAuditoria {
  CRIACAO
  ALTERACAO
  ALTERACAO_STATUS
  MUDANCA_GARAGEM
  EXCLUSAO
  CANCELAMENTO
  DEVOLUCAO
}

model RegistroAuditoria {
  id         String           @id @default(uuid()) @db.Uuid
  // Quem: conta autenticada (id do JWT) e o cargo com que agiu.
  idAtor     String           @db.Uuid
  cargoAtor  Cargo
  // Dono do recurso afetado: escopo da consulta do locador.
  idLocador  String           @db.Uuid
  entidade   EntidadeAuditada
  idEntidade String           @db.Uuid
  acao       AcaoAuditoria
  antes      Json?
  depois     Json?
  criadoEm   DateTime         @default(now())

  @@index([entidade, idEntidade, criadoEm])
  @@index([idLocador, criadoEm])
}

model AlertaVeiculo {
  id String @id @default(uuid()) @db.Uuid

  tipo TipoAlertaVeiculo

  idVeiculo String  @db.Uuid
  veiculo   Veiculo @relation(fields: [idVeiculo], references: [id], onDelete: Cascade)

  idLocador String  @db.Uuid
  locador   Locador @relation(fields: [idLocador], references: [id], onDelete: Cascade)

  descricao String

  // Snapshot do destinatário e do assunto no momento da tentativa de envio.
  destinatario String
  assunto      String
  canal        String @default("EMAIL")

  status       StatusNotificacao @default(PENDENTE)
  mensagemErro String?
  tentativas   Int               @default(0)

  criadoEm     DateTime  @default(now())
  enviadoEm    DateTime?
  // Encerramento do alerta (condição deixou de valer). NULL = ativo.
  resolvidoEm  DateTime?
  atualizadoEm DateTime  @default(now()) @updatedAt

  // Consulta crítica da deduplicação: alerta ativo por (veículo, tipo).
  @@index([idVeiculo, tipo, resolvidoEm])
  // Histórico de alertas por locador (auditoria).
  @@index([idLocador, criadoEm])
}

model CondutorAdicional {
  id String @id @default(uuid()) @db.Uuid

  idReserva String  @db.Uuid
  reserva   Reserva @relation(fields: [idReserva], references: [id], onDelete: Cascade)

  nome String
  cpf  String?
  cnh  String

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  // Um mesmo condutor (CNH) não pode ser cadastrado duas vezes na reserva.
  @@unique([idReserva, cnh])
  @@index([idReserva])
}

model Localizacao {
  id String @id @default(uuid()) @db.Uuid

  idVeiculo String  @db.Uuid
  veiculo   Veiculo @relation(fields: [idVeiculo], references: [id], onDelete: Cascade)

  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)

  dataHora     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  // Acelera histórico cronológico e busca da última localização por veículo.
  @@index([idVeiculo, dataHora])
}

model Avaliacao {
  id String @id @default(uuid()) @db.Uuid

  idReserva String  @unique @db.Uuid
  reserva   Reserva @relation(fields: [idReserva], references: [id], onDelete: Cascade)

  comentario String?
  data       DateTime @default(now())

  nota         Decimal  @db.Decimal(2, 1)
  atualizadoEm DateTime @default(now()) @updatedAt
}

model BloqueioLocatario {
  id String @id @default(uuid()) @db.Uuid

  idLocatario String    @db.Uuid
  locatario   Locatario @relation(fields: [idLocatario], references: [id], onDelete: Cascade)

  motivo    MotivoBloqueio
  descricao String?

  criadoEm DateTime @default(now())

  // null = bloqueio permanente; caso contrário, deixa de ser impeditivo após a data.
  expiraEm DateTime?

  // Revogação administrativa. Preserva o registro para auditoria (não deletamos).
  revogadoEm DateTime?

  // Auditoria: contas (admin) que criaram/revogaram o bloqueio.
  criadoPor   String? @db.Uuid
  revogadoPor String? @db.Uuid

  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([idLocatario, revogadoEm, expiraEm])
}
