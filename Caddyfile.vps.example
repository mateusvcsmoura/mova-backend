{
    email {$ACME_EMAIL}
}

# Caddy é somente proxy reverso/terminação HTTPS. Não é CDN.
# O bucket privado não tem rota aqui; o console MinIO (9001) também não.
{$MEDIA_DOMAIN} {
    @publicImages {
        method GET HEAD
        path /mova-media-public/*
    }

    handle @publicImages {
        header {
            Cache-Control "public, max-age=31536000, immutable"
            X-Content-Type-Options "nosniff"
        }
        reverse_proxy minio:9000
    }

    handle {
        respond 404
    }
}
