DATABASE_URL="postgresql://mova:mova@localhost:5433/mova_dev"
DIRECT_URL="postgresql://mova:mova@localhost:5433/mova_dev"

DATABASE_URL_TEST="postgresql://mova:mova@localhost:5433/mova_test"
DIRECT_URL_TEST="postgresql://mova:mova@localhost:5433/mova_test"


SERVER_PORT=
NODE_ENV=

JWT_SECRET=
JWT_EXPIRES_IN=
PASSWORD_RESET_TTL_MINUTES=30
FRONTEND_URL=http://localhost:5173

CORS_ORIGINS=
# Tamanho máximo do corpo JSON (padrão 100kb).
BODY_LIMIT=100kb
# Rate limiting (padrões: janela 15min, 10 auth, 100 escrita por IP).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_MAX=100

TIMEZONE_EXIBICAO=America/Sao_Paulo

DESBLOQUEIO_RAIO_METROS=100

# Simulador de rastreador GPS (mock). "true" liga o auto-update no boot.
LOCALIZACAO_SIMULADOR=
LOCALIZACAO_SIMULADOR_INTERVALO_MS=

MONITORAMENTO_VEICULOS=
MONITORAMENTO_INTERVALO_MS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password-de-16-digitos
SMTP_FROM="Mova <seu-email@gmail.com>"
SEND_REAL_EMAIL=true
PAGAMENTO_SANDBOX_PROVIDER=mercadopago
PAGAMENTO_SIMULADOR_DELAY_MS=1500
# Somente sandbox/teste: falha a primeira tentativa simulada e exercita o retry.
PAGAMENTO_SANDBOX_ESTORNO_FALHA_UNICA=

MERCADOPAGO_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
ASAAS_WEBHOOK_SECRET=

MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PRIVATE_BUCKET=mova-media-private
MEDIA_PUBLIC_BUCKET=mova-media-public
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/mova-media-public
MEDIA_MAX_BYTES=5242880
MEDIA_MAX_WIDTH=4096
MEDIA_MAX_HEIGHT=4096
MEDIA_MAX_IMAGES_PER_VEHICLE=12
MEDIA_CLEANUP_MIN_AGE_MINUTES=60
