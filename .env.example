DATABASE_URL=
DIRECT_URL=

DATABASE_URL_TEST=
DIRECT_URL_TEST=


SERVER_PORT=
NODE_ENV=

JWT_SECRET=
JWT_EXPIRES_IN=

# Simulador de rastreador GPS (mock). "true" liga o auto-update no boot.
LOCALIZACAO_SIMULADOR=
LOCALIZACAO_SIMULADOR_INTERVALO_MS=

# SMTP (Nodemailer). Para o Gmail use uma App Password (não a senha da conta).
# Deixe em branco para desabilitar o envio de e-mails (dev/testes).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password-de-16-digitos
SMTP_FROM="Mova <seu-email@gmail.com>"
